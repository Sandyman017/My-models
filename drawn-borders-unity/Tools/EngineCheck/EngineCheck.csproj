<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the Unity version's engine against the web game, outside Unity (see Tools/README.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Assets/DrawnBorders/Engine/**/*.cs" />
    <Compile Include="../../Assets/DrawnBorders/Bake/**/*.cs" />
  </ItemGroup>
</Project>
